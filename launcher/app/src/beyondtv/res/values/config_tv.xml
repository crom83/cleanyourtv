<?xml version="1.0" encoding="utf-8"?>
<!-- TCL BeyondTV (Android TV 11, Realtek rtd285o). Overrides the values of the same name in main/config.xml. -->
<resources>
    <string-array name="dock_apps">
        <item>ru.kinopoisk.tv</item>
        <item>com.kinopub</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.spotify.tv.android</item>
        <item>com.android.vending</item>
    </string-array>
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>
    <string-array name="app_keys" translatable="false">
        <!-- The Netflix key (4062) opens kinopub on the home screen -->
        <item>4062:com.kinopub</item>
    </string-array>
    <!-- Live tiles on: the weather and smart home add-ons put their line on their tiles -->
    <bool name="live_cards">true</bool>
</resources>
