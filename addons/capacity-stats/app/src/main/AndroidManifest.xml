<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- "Free up memory": unloads other apps' background processes, the ones this app can see below -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
    </queries>
    <application android:allowBackup="false" android:supportsRtl="true" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:label="@string/app_name" android:icon="@drawable/icon" android:banner="@drawable/icon">
        <activity android:name=".StatsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.gathin.tvhome.category.DOCK_CARD" /></intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <!-- Clean Your TV live card: the launcher reads free memory from here, only while Home is on screen -->
        <meta-data android:name="com.gathin.tvhome.live" android:value="${applicationId}.card" />
        <provider
            android:name=".LiveCardProvider"
            android:authorities="${applicationId}.card"
            android:exported="true" />
    </application>
</manifest>
