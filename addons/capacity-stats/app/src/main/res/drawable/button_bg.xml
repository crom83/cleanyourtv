<?xml version="1.0" encoding="utf-8"?>
<!-- A pill: glassy at rest, white when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFF2F5F7" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#1FFFFFFF" /><stroke android:width="1dp" android:color="#26FFFFFF" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
