<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the hour strip: time, icon, temperature, chance of precipitation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/hourTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />

    <io.github.sumyabazar1.weather.WeatherIcon
        android:id="@+id/hourIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/hourTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/hourRain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF81D4FA"
        android:textSize="12sp" />
</LinearLayout>
